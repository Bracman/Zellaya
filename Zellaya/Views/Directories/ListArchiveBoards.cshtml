@{
    Layout = null;
    ViewData["Title"] = "Архив электронных плат";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/list_boards.css" />
    <script src="~/js/order_script.js"></script>
</head>

<body>
    <!-- Мобильная шапка -->
    <div class="mobile-header">
        <button class="hamburger" id="hamburger">&#9776;</button>
        <span class="header-title">Меню</span>
    </div>

    <!-- Мобильная боковая панель -->
    <div class="mobile-sidebar" id="mobileSidebar">
        <button class="close-btn" id="closeBtn">&times;</button>
        <div class="sidebar-content">
            <button type="button" onclick="location.href='#'">Производство</button>
            <button type="button" onclick="location.href='#'">Справочники</button>
            <button type="button" onclick="location.href='#'">База знаний</button>
            <button type="button" onclick="location.href='#'">Склад</button>
            <button type="button" onclick="location.href='#'">Настройки</button>
            <button type="button" class="exit" onclick="location.href='#'">Выход</button>
        </div>
    </div>    
    <div class="sidebar desktop-sidebar">
        <button type="button" onclick="location.href='@Url.Action("Index", "Orders")'">Управление производством</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Directories")'">Справочники</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Inventory")'">Кладовая</button>
        <button type="button" onclick="location.href='#'">Калькулятор</button>
        <button type="button" onclick="location.href='#'">Настройки</button>
        <button type="button" class="exit" onclick="location.href='@Url.Action("Login", "Account")'">Выход</button>
    </div>
    <div class="content">
        <div class="table-container">
            <h1>Cписок архивированных плат</h1>

            <table id="ordersTable">
                <thead>
                    <tr>
                        <th>Название платы</th>
                        <th>Номер платы</th>
                        <th>Чертёж</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var board in Model)
                    {
                        <tr>
                            <td>@board.name_board</td>
                            <td>@board.code_board</td>
                            <td>
                                @if (board.id_document != null)
                                {
                                    <a href="@Url.Action("OpenDoc", "Directories", new { id = board.id_board })" target="_blank">
                                        Открыть
                                    </a>
                                }
                                else
                                {
                                    <span style="color:gray;">Нет файла</span>
                                }
                            </td>                            
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</body>
</html>