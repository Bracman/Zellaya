@model OrderDetails
@{
    Layout = null;
    ViewData["Title"] = "Посмотреть информацию о заказе";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/order_details.css" />
</head>

<body>

    <!-- Мобильная шапка -->
    <div class="mobile-header">
        <button class="hamburger" id="hamburger">&#9776;</button>
        <span class="header-title">Меню</span>
    </div>

    <!-- Мобильная боковая панель -->
    <div class="mobile-sidebar" id="mobileSidebar">
        <button class="close-btn" id="closeBtn">&times;</button>

        <div class="sidebar-content">
            <button type="button">Заказы</button>
            <button type="button">База знаний</button>
            <button type="button">Кладовая</button>
            <button type="button">Калькулятор</button>
            <button type="button">Настройки</button>
            <button type="button">Выход</button>
        </div>
    </div>

    <!-- Десктопный сайдбар -->
    <div class="sidebar desktop-sidebar">
        <button type="button" onclick="location.href='@Url.Action("Index", "Orders")'">Управление производством</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Directories")'">Справочники</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Inventory")'">Склад</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Settings")'">Настройки</button>
        <button type="button" class="exit" onclick="location.href='@Url.Action("Login", "Account")'">Выход</button>
    </div>

    <!-- ОСНОВНОЙ КОНТЕНТ -->
    <div class="content">
        <div class="table-container">

            <h1>Детали заказа</h1>

            <div class="order-info">
                <p><strong>Номер заказа:</strong> @Model.order_number</p>
                <p><strong>Дата создания:</strong> @Model.CreatedDate</p>
                <p><strong>Дата готовности:</strong> @Model.ReadyDate</p>
            </div>

            <hr />

            <h3>Состав заказа</h3>

            <table id="ordersTable">
                <thead>
                    <tr>
                        <th>Имя платы</th>
                        <th>Тип компонента</th>
                        <th>Кол-во компонента</th>
                        <th>Номер компонента</th>
                    </tr>
                </thead>
                <div class="status-box">
                    <form method="post" asp-action="ChangeStatus" asp-controller="UserPanel">

                        <input type="hidden" name="id" value="@Model.order_number" />

                        <label><strong>Статус заказа:</strong></label>

                        <select name="status" class="status-select">

                            @if (Model.status_order == "Создан")
                            {
                                <option value="Создан" selected>Создан</option>
                            }
                            else
                            {
                                <option value="Создан">Создан</option>
                            }

                            @if (Model.status_order == "В работе")
                            {
                                <option value="В работе" selected>В работе</option>
                            }
                            else
                            {
                                <option value="В работе">В работе</option>
                            }

                            @if (Model.status_order == "Выполнен")
                            {
                                <option value="Выполнен" selected>Выполнен</option>
                            }
                            else
                            {
                                <option value="Выполнен">Выполнен</option>
                            }

                            @if (Model.status_order == "Закрыт")
                            {
                                <option value="Закрыт" selected>Закрыт</option>
                            }
                            else
                            {
                                <option value="Закрыт">Закрыт</option>
                            }

                        </select>

                        <button type="submit" class="btn-save">Сохранить</button>
                    </form>
                </div>

                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.name_component</td>
                                <td>@item.type_component</td>
                                <td>@item.count_component</td>
                                <td>@item.part_number</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align:center">
                                Нет данных по компонентам
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <br />
            <a href="@Url.Action("Index", "Orders")">← Назад к списку</a>
        </div>
    </div>

    <script src="~/js/order_script.js"></script>

</body>
</html>