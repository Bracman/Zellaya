@{
    Layout = null;
    ViewData["Title"] = "Заказы";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Интерфейс</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    <div class="mobile-header">
        <button class="hamburger" id="hamburger">&#9776;</button>
        <span class="header-title">Меню</span>
    </div>

    <div class="mobile-sidebar" id="mobileSidebar">
        <button class="close-btn" id="closeBtn">&times;</button>
        <div class="sidebar-content">
            <button onclick="changeContent('orders')">Заказы</button>
            <button onclick="changeContent('knowledgeBase')">База знаний</button>
            <button onclick="changeContent('warehouse')">Кладовая</button>
            <button onclick="changeContent('calculator')">Калькулятор</button>
            <button onclick="changeContent('settings')">Настройки</button>
            <button class="exit" onclick="changeContent('exit')">Выход</button>
        </div>
    </div>

    <div class="sidebar desktop-sidebar">
        <button type="button" onclick="location.href='@Url.Action("Index", "Orders")'">Управление производством</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Directories")'">Справочники</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Inventory")'">Кладовая</button>
        <button type="button" onclick="location.href='#'">Калькулятор</button>
        <button type="button" onclick="location.href='#'">Настройки</button>
        <button type="button" class="exit" onclick="location.href='@Url.Action("Login", "Account")'">Выход</button>
    </div>
    <div class="content" id="mainContent">
        <section id="ordersContent" class="orders">
            <div class="orders-box">
                <header class="orders-head">
                    <h2>Управление производством</h2>
                    <p class="muted">Что делаем дальше?</p>
                </header>

                <nav class="actions-grid">
                    <a asp-controller="Orders" asp-action="Create" class="action-tile" id="createOrderLink">
                        <span class="icon">
                            <img src="~/icons/doc_smale.svg" />
                        </span>
                        <span class="title">Создать заказ</span>
                        <span class="desc">Создать заказ на производство плат</span>
                    </a>

                    <a asp-controller="Orders" asp-action="ListOrders" class="action-tile" id="showOrdersListLink">
                        <span class="icon">
                            <img src="~/icons/folder.svg" />
                        </span>
                        <span class="title">Посмотреть заказы</span>
                        <span class="desc">Список заказов на производство плат </span>
                    </a>

                    <a href="#" class="action-tile" id="showCreateRequestLink">
                        <span class="icon">
                            <img src="~/icons/doc_sad.svg" />
                        </span>
                        <span class="title">Создать запрос на доработку</span>
                        <span class="desc">Создание запроса для внесение изменений</span>
                    </a>

                    <a href="#" class="action-tile" id="showRequestsListLink">
                        <span class="icon">
                            <img src="~/icons/docs.svg" width="50" height="50" />
                        </span>
                        <span class="title">Просмотр доработок</span>
                        <span class="desc">Список изменений</span>
                    </a>
                </nav>
            </div>
        </section>
    </div>

    <script src="~/js/script.js"></script>
</body>
</html>