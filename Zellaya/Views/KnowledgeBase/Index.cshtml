@{
    Layout = null; 
    ViewData["Title"] = "База знаний";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <div class="mobile-header">
        <button class="hamburger" id="hamburger">&#9776;</button>
        <span class="header-title">Меню</span>
    </div>

    <div class="mobile-sidebar" id="mobileSidebar">
        <button class="close-btn" id="closeBtn">&times;</button>
        <div class="sidebar-content">
            <button onclick="changeContent('orders')">Заказы</button>
            <button onclick="changeContent('knowledgeBase')">База знаний</button>
            <button onclick="changeContent('warehouse')">Кладовая</button>
            <button onclick="changeContent('calculator')">Калькулятор</button>
            <button onclick="changeContent('settings')">Настройки</button>
            <button class="exit" onclick="changeContent('exit')">Выход</button>
        </div>
    </div>

    <div class="sidebar desktop-sidebar">
        <button button type="button" onclick="location.href='@Url.Action("Index", "Orders")'">Заказы</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "KnowledgeBase")'">База знаний</button>
        <button onclick="changeContent('warehouse')">Кладовая</button>
        <button onclick="changeContent('calculator')">Калькулятор</button>
        <button onclick="changeContent('settings')">Настройки</button>
        <button class="exit" onclick="changeContent('exit')">Выход</button>
    </div>

    <div class="content">
        <section id="knowledgeBaseContent" class="section">
            <h2>База знаний</h2>
            <ul class="actions">
                <li><a asp-controller="KnowledgeBase" asp-action="BoardsCheck">Проверка плат</a></li>
                <li><a asp-controller="KnowledgeBase" asp-action="Components">Радиокомпоненты</a></li>
            </ul>
        </section>
    </div>

    <script src="~/js/script.js" asp-append-version="true"></script>
</body>
</html>
