@{
    Layout = null;
    ViewData["Title"] = "Склад";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/inventory.css" />
    <script src="~/js/order_script.js"></script>
</head>

<body>

    <!-- Мобильная шапка -->
    <div class="mobile-header">
        <button class="hamburger" id="hamburger">&#9776;</button>
        <span class="header-title">Меню</span>
    </div>

    <!-- Мобильная боковая панель -->
    <div class="mobile-sidebar" id="mobileSidebar">
        <button class="close-btn" id="closeBtn">&times;</button>

        <div class="sidebar-content">
            <button type="button" onclick="location.href='@Url.Action("Index", "Orders")'">Производство</button>
            <button type="button" onclick="location.href='@Url.Action("Index", "Directories")'">Справочники</button>
            <button type="button" onclick="location.href='@Url.Action("Index", "KnowledgeBase")'">База знаний</button>
            <button type="button" onclick="location.href='@Url.Action("Index", "Inventory")'">Склад</button>
            <button type="button" onclick="location.href='#'">Настройки</button>
            <button type="button" class="exit" onclick="location.href='@Url.Action("Login", "Account")'">Выход</button>
        </div>
    </div>

    <!-- Десктопный сайдбар -->
    <div class="sidebar desktop-sidebar">
        <button type="button" onclick="location.href='@Url.Action("Index", "Orders")'">Управление производством</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Directories")'">Справочники</button>
        <button type="button" onclick="location.href='@Url.Action("Index", "Inventory")'">Склад</button>       
        <button type="button" onclick="location.href='@Url.Action("Index", "Settings")'">Настройки</button>
        <button type="button" class="exit" onclick="location.href='@Url.Action("Login", "Account")'">Выход</button>
    </div>

    <!-- Контент -->
    <main class="content">
        <section class="inv-page">
            <div class="inv-card">

                <header class="inv-header">
                    <h1>Склад</h1>
                    <p>Управление остатками и движением радиокомпонентов</p>
                </header>

                <div class="inv-grid">

                    <a class="inv-tile" href="@Url.Action("Balances", "Inventory")">                       
                        <div class="tile-title">Остатки</div>
                        <div class="tile-desc">Просмотр остатков по компонентам</div>
                    </a>

                    <a class="inv-tile" href="@Url.Action("Move", "Inventory")">                        
                        <div class="tile-title">Приход / Расход</div>
                        <div class="tile-desc">Добавить движение на склад</div>
                    </a>

                    <a class="inv-tile" href="@Url.Action("Movements", "Inventory")">                        
                        <div class="tile-title">Журнал</div>
                        <div class="tile-desc">История движений склада</div>
                    </a>

                    <a class="inv-tile" href="@Url.Action("Index", "PurchaseOrders")">                        
                        <div class="tile-title">Заказы поставщику</div>
                        <div class="tile-desc">Создание и приём поставок</div>
                    </a>                   

                </div>

            </div>
        </section>
    </main>

</body>
</html>
